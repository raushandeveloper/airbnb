 <% if(errors.length > 0) { %>
              <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded relative mb-4" role="alert">
                <strong class="font-bold">Error!</strong>
                <ul class="list-disc list-inside">
                  <% errors.forEach(error => { %>
                    <li><%= error %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>