<%- include('../partials/head') %>
  </head>
  <body class="bg-[#f5efe6]">
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-10 max-w-6xl rounded-2xl bg-[#fbf8f3] p-8 shadow-xl">
      <h2 class="mb-8 text-center text-3xl font-bold text-red-500">
        Here are our registered homes:
      </h2>

      <div class="flex flex-wrap justify-center gap-6">
        <% registeredHomes.forEach(home => { %>
          <div class="w-full max-w-sm overflow-hidden rounded-2xl border border-[#e8dcc8] bg-white shadow-md transition duration-300 hover:-translate-y-1 hover:shadow-xl">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="h-48 w-full object-cover">

            <div class="p-5">
              <h3 class="mb-2 text-xl font-semibold text-[#6b4f3a]"><%= home.houseName %></h3>
              <p class="mb-4 text-sm text-[#8a735d]">
                <i class="fas fa-map-marker-alt mr-2 text-red-400"></i>
                <%= home.location %>
              </p>

              <div class="mb-4 flex items-center justify-between">
                <span class="text-lg font-bold text-red-500">Rs <%= home.price %> / night</span>
                <div class="flex items-center gap-1 rounded-full bg-rose-50 px-2 py-1">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 text-yellow-400">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                  <span class="text-sm font-medium text-[#7d654e]"><%= home.rating %></span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a class="rounded-md bg-blue-400 px-4 py-2 font-semibold text-white transition duration-300 hover:bg-blue-500" href="/homes/<%= home._id %>">Details</a>
                <%- include('../partials/favourite', {home: home}) %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
  </body>
</html>
